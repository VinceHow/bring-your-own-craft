diff --git a/public/looks/painted.css b/public/looks/painted.css
index 0d825b9..44e7692 100644
--- a/public/looks/painted.css
+++ b/public/looks/painted.css
@@ -976,3 +976,63 @@ html #room .painted-status::after { content: ''; position: absolute; inset: 0; z
 @keyframes pt-status { from { opacity: 0; translate: 0 6px; } }
 /* chatter bubbles sit ABOVE their speaker's pill (the room places them under it), clear of every face */
 html #room .chatter-line { translate: 0 calc(-100% - 58px); border-radius: var(--r-md) var(--r-md) var(--r-md) 6px; max-width: 300px; }
+
+/* ---------- meet the team (setup step "team"), as the first-open v3 meet card (design studio, 14 Nov) ----------
+   Hooks only: setup[data-step="team"], meet-card[data-seat][data-state="in"], data-slot face · name · role ·
+   agent-mark · line · brings · count. The face slot holds the teammate's wave clip (painted.js drops in a muted,
+   looping <video> with their portrait as the poster; without it, the portrait alone). The same blurred studio door
+   is behind it as behind her name tag. */
+html #room [data-component="setup"][data-step="team"] { background: #E9DCC6; isolation: isolate; }
+html #room [data-component="setup"][data-step="team"]::before { content: ''; position: absolute; inset: -24px; z-index: -1; pointer-events: none;
+  background: url(cast/intro/door.jpg) center 42% / cover no-repeat; filter: blur(9px) saturate(.92); }
+html #room [data-component="setup"][data-step="team"]::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
+  background: radial-gradient(80% 80% at 50% 45%, rgba(255,240,215,.10), rgba(239,220,190,.26)); }
+html #room [data-component="meet-card"] { --mc: var(--cr-product); --fw: 420px; --gap: 44px; position: relative; isolation: isolate; display: block; box-sizing: border-box;
+  width: calc(var(--fw) + var(--gap) + 470px); max-width: 94vw; min-height: calc(var(--fw) + 24px); margin: 0 auto;
+  padding: 58px 34px 64px calc(var(--fw) + var(--gap) + 34px); border: 0; background: none; box-shadow: none; }
+html #room [data-component="meet-card"][data-seat="design"] { --mc: var(--cr-design); --mt: #2D4775; }
+html #room [data-component="meet-card"][data-seat="research"] { --mc: var(--cr-research); --mt: #8E3F22; }
+html #room [data-component="meet-card"][data-seat="data"] { --mc: var(--cr-data); --mt: #3E5E3F; }
+html #room [data-component="meet-card"][data-seat="strategy"] { --mc: var(--cr-strategy); --mt: #6F4A12; }
+html #room [data-component="meet-card"][data-seat="engineering"] { --mc: var(--cr-engineering); --mt: #634A08; }
+/* the face: their painted corner, waving, in an inked, rounded frame with their crayon under it */
+html #room [data-component="meet-card"] [data-slot="face"] { position: absolute; left: 12px; top: 50%; translate: 0 -50%; display: block; width: calc(var(--fw) - 24px); height: auto; aspect-ratio: 1;
+  border: 0; border-radius: 34px; overflow: hidden; background: #EADBC0 center / cover no-repeat;
+  box-shadow: 0 0 0 12px #FBF5EA, 0 0 0 13.6px rgba(51,38,28,.75), 12px 14px 0 13px var(--mc), 14px 18px 26px 10px rgba(50,28,12,.28); }
+html #room [data-component="meet-card"][data-seat="design"] [data-slot="face"] { background-image: url(cast/intro/mika.jpg); }
+html #room [data-component="meet-card"][data-seat="research"] [data-slot="face"] { background-image: url(cast/intro/noor.jpg); }
+html #room [data-component="meet-card"][data-seat="data"] [data-slot="face"] { background-image: url(cast/intro/theo.jpg); }
+html #room [data-component="meet-card"][data-seat="strategy"] [data-slot="face"] { background-image: url(cast/intro/ines.jpg); }
+html #room [data-component="meet-card"][data-seat="engineering"] [data-slot="face"] { background-image: url(cast/intro/bo.jpg); }
+html #room [data-component="meet-card"] [data-slot="face"] video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+/* their card: ink paper on their crayon, to the right of the frame */
